<icegrid>
    <application name="SpotificeApp">
        
        <!-- Propiedades comunes -->
        <properties id="CommonProperties">
            <property name="Ice.Default.Locator" value="SpotificeGrid/Locator:tcp -h registry -p 4061"/>
        </properties>

        <!-- Template para MediaServer -->
        <server-template id="MediaServerTemplate">
            <parameter name="index"/>
            <server id="MediaServer${index}" exe="python3" activation="on-demand" pwd="/app">
                <option>media_server.py</option>
                <properties>
                    <properties refid="CommonProperties"/>
                    <property name="MediaServerAdapter.Endpoints" value="tcp -h 0.0.0.0"/>
                    <property name="MediaServerAdapter.AdapterId" value="MediaServerAdapter${index}"/>
                </properties>
                <adapter name="MediaServerAdapter" id="MediaServerAdapter${index}" endpoints="tcp -h 0.0.0.0" replica-group="MediaServerGroup"/>
            </server>
        </server-template>

        <!-- Template para MediaRender -->
        <server-template id="MediaRenderTemplate">
            <parameter name="index"/>
            <server id="MediaRender${index}" exe="python3" activation="on-demand" pwd="/app">
                <option>media_render.py</option>
                <properties>
                    <properties refid="CommonProperties"/>
                    <property name="MediaRenderAdapter.Endpoints" value="tcp -h 0.0.0.0"/>
                    <property name="MediaRenderAdapter.AdapterId" value="MediaRenderAdapter${index}"/>
                </properties>
                <adapter name="MediaRenderAdapter" id="MediaRenderAdapter${index}" endpoints="tcp -h 0.0.0.0" replica-group="MediaRenderGroup"/>
            </server>
        </server-template>

        <!-- Grupos de réplica para balanceo de carga -->
        <replica-group id="MediaServerGroup">
            <load-balancing type="random"/>
            <object identity="mediaServer1" type="::Spotifice::MediaServer"/>
        </replica-group>

        <replica-group id="MediaRenderGroup">
            <load-balancing type="random"/>
            <object identity="mediaRender1" type="::Spotifice::MediaRender"/>
        </replica-group>

        <!-- Nodo 1: MediaServer1 + MediaRender1 -->
        <node name="node1">
            <server-instance template="MediaServerTemplate" index="1"/>
            <server-instance template="MediaRenderTemplate" index="1"/>
        </node>

        <!-- Nodo 2: MediaServer2 + MediaRender2 -->
        <node name="node2">
            <server-instance template="MediaServerTemplate" index="2"/>
            <server-instance template="MediaRenderTemplate" index="2"/>
        </node>

    </application>
</icegrid>
