# Configuración del cliente para usar MediaRender local
# MediaServers en Docker, MediaRender en el host

Ice.Default.Locator=SpotificeGrid/Locator:tcp -h localhost -p 4061

# MediaServer en Docker (grupo de réplica)
MediaServer.Proxy=mediaServer1@MediaServerGroup

# MediaRender local (proxy directo - ajustar puerto si es necesario)
MediaRender.Proxy=mediaRender:tcp -h localhost -p 10000

# Timeouts
Ice.Override.ConnectTimeout=5000
Ice.Override.Timeout=10000

# Retry
Ice.RetryIntervals=0 100 500
