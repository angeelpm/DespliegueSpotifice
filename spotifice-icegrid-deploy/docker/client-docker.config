# Configuración del cliente para conectar al sistema Docker
# Uso: python media_control.py --Ice.Config=docker/client-docker.config

# Locator para conectar al registry
Ice.Default.Locator=IceGrid/Locator:tcp -h localhost -p 4061

# Proxies bien conocidos (usarán el locator para resolverse)
MediaServer.Proxy=mediaServer@MediaServerGroup
MediaRender.Proxy=mediaRender@MediaRenderGroup

# También puedes conectar a servidores específicos:
# MediaServer1.Proxy=mediaServer1
# MediaServer2.Proxy=mediaServer2
# MediaRender1.Proxy=mediaRender1
# MediaRender2.Proxy=mediaRender2

# Tracing (opcional, para debug)
Ice.Trace.Locator=1
Ice.Trace.Network=0
