<icegrid>
    <application name="SpotificeApp">
        
        <properties id="CommonProperties">
            <property name="Ice.Default.Locator" value="SpotificeGrid/Locator:tcp -h localhost -p 24061"/>
        </properties>

        <!-- Servidor IcePatch2 para distribución de archivos -->
        <server-template id="IcePatch2Template">
            <parameter name="instance-name" default="${application}.IcePatch2"/>
            <server id="${instance-name}" exe="icepatch2server" activation="on-demand" application-distrib="false">
                <properties>
                    <properties refid="CommonProperties"/>
                    <property name="IcePatch2.InstanceName" value="${instance-name}"/>
                    <property name="IcePatch2.Directory" value="/home/angel/Escritorio/SpoificeDespliegue/DespliegueSpotifice/spotifice-icegrid-deploy"/>
                </properties>
                <adapter name="IcePatch2" endpoints="tcp" id="${instance-name}">
                    <object identity="${instance-name}/server" type="::IcePatch2::FileServer"/>
                </adapter>
            </server>
        </server-template>

        <!-- Template para MediaServer con distribución IcePatch2 -->
        <server-template id="MediaServerTemplate">
            <parameter name="index"/>
            <server id="MediaServer${index}" exe="python3" activation="on-demand" pwd="${server.distrib}">
                <distrib icepatch="${application}.IcePatch2/server"/>
                <option>media_server.py</option>
                <properties>
                    <properties refid="CommonProperties"/>
                    <property name="MediaServerAdapter.Endpoints" value="tcp"/>
                    <property name="MediaServerAdapter.AdapterId" value="MediaServerAdapter${index}"/>
                </properties>
                <adapter name="MediaServerAdapter" id="MediaServerAdapter${index}" endpoints="tcp" replica-group="MediaServerGroup"/>
            </server>
        </server-template>

        <!-- Template para MediaRender con distribución IcePatch2 -->
        <server-template id="MediaRenderTemplate">
            <parameter name="index"/>
            <server id="MediaRender${index}" exe="python3" activation="on-demand" pwd="${server.distrib}">
                <distrib icepatch="${application}.IcePatch2/server"/>
                <option>media_render.py</option>
                <properties>
                    <properties refid="CommonProperties"/>
                    <property name="MediaRenderAdapter.Endpoints" value="tcp"/>
                    <property name="MediaRenderAdapter.AdapterId" value="MediaRenderAdapter${index}"/>
                </properties>
                <adapter name="MediaRenderAdapter" id="MediaRenderAdapter${index}" endpoints="tcp" replica-group="MediaRenderGroup"/>
            </server>
        </server-template>

        <replica-group id="MediaServerGroup">
            <load-balancing type="random"/>
            <object identity="mediaServer1" type="::Spotifice::MediaServer"/>
        </replica-group>

        <replica-group id="MediaRenderGroup">
            <load-balancing type="random"/>
            <object identity="mediaRender1" type="::Spotifice::MediaRender"/>
        </replica-group>

        <!-- Nodo 1: IcePatch2 Server + MediaServer1 + MediaRender1 -->
        <node name="node1">
            <server-instance template="IcePatch2Template"/>
            <server-instance template="MediaServerTemplate" index="1"/>
            <server-instance template="MediaRenderTemplate" index="1"/>
        </node>

        <!-- Nodo 2: MediaServer2 + MediaRender2 -->
        <node name="node2">
            <server-instance template="MediaServerTemplate" index="2"/>
            <server-instance template="MediaRenderTemplate" index="2"/>
        </node>

    </application>
</icegrid>
