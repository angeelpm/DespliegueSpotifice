# Dockerfile para nodos IceGrid
FROM spotifice-base:latest

# Argumentos de construcción
ARG NODE_NAME=node1

# Variables de entorno
ENV NODE_NAME=${NODE_NAME}
ENV NODE_DATA_DIR=/data/${NODE_NAME}

# Crear directorios del nodo
RUN mkdir -p ${NODE_DATA_DIR}

# Copiar archivos de la aplicación
COPY media_server.py media_render.py gst_player.py /app/
COPY spotifice_v2.ice /app/
COPY users.json /app/

# Copiar directorios de media y playlists
COPY media/ /app/media/
COPY playlists/ /app/playlists/

# Exponer puertos para Ice
EXPOSE 10000-10100

# El comando se especificará en docker-compose
CMD ["icegridnode", "--Ice.Config=/config/node.cfg"]
