# Configuración del cliente para conectarse al entorno Docker
# El registry está expuesto en localhost:4061

Ice.Default.Locator=SpotificeGrid/Locator:tcp -h localhost -p 4061

# Proxies indirectos a los grupos de réplica
MediaServer.Proxy=mediaServer1@MediaServerGroup
MediaRender.Proxy=mediaRender1@MediaRenderGroup

# Timeouts
Ice.Override.ConnectTimeout=5000
Ice.Override.Timeout=10000

# Retry
Ice.RetryIntervals=0 100 500
